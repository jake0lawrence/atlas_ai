{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/", "destination": "/atlas/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/atlas/api/:path*", "destination": "/api/:path*" },
    { "source": "/atlas/assets/:path*", "destination": "/assets/:path*" },
    { "source": "/atlas/:file(favicon\\.svg|og\\.png)", "destination": "/:file" },
    { "source": "/atlas", "destination": "/index.html" },
    { "source": "/atlas/:path*", "destination": "/index.html" }
  ]
}
